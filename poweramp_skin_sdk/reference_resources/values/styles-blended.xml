    <!--
	  Default: the labels and the rating/menu row over the cover, no space below it
	  +==========================================+  <== 0, the status bar is the top inset
	  |                                          |
	  |                 cover                    |
	  |                                          |  <== fade start: aaBlendedFadeStart x the art height (62%),
	  |                                          |      at most aaBlendedFadeGap (16dp) above the overlay top
	  |  Title                                   |  <== overlay top: aaBlendedOverlayReserve (@id/blended_overlay_reserve)
	  |  Artist - Album                          |      above the image view bottom, kept below the safe top inset
	  |  [like] [unlike]                 [menu]  |
	  +==========================================+  <== art bottom: aaItemHeightPercent x H (60%), lowered to fit the
	  |                                          |      controls; also the image view and item bottom, aaPaddingBottom is 0dp
	  |  [vis] [timer]     (controls)    [shuf]  |  <== aaMarginBottom as in Alternative
	  +==========================================+  <== H - the system bottom inset

	  Alternative layout. The art shrinks first when the reserves don't fit
	  +==========================================+  <== 0, the status bar is the top inset
	  |                                          |
	  |                 cover                    |
	  |                                          |
	  |                                          |  <== fade start: aaBlendedFadeStart x the art height (62%),
	  |                                          |      at most aaBlendedFadeGap (16dp) above the overlay top
	  |  [like] [unlike]                 [menu]  |  <== overlay top: aaBlendedOverlayReserve (?Blended_buttonRow) above
	  |                                          |      the image view bottom, kept below the safe top inset
	  +==========================================+  <== art bottom: aaItemHeightPercent x H (60%), lowered to fit the
	  |  Title                                   |      reserves below; also the image view bottom
	  |  Artist - Album                          |  <== aaPaddingBottom (@id/blended_alt_below_art_reserve): the labels
	  |                                          |      inside the item, below the art
	  +==========================================+  <== item bottom
	  |  [vis] [timer]          [repeat] [shuf]  |  <== aaMarginBottom (@id/blended_controls_reserve): the controls
	  |       |<<    <<    ( > )    >>    >>|    |      below the item, including the app navbar
	  |  |||||||||||||| waveseek ||||||||||||||  |
	  |  0:05                              5:32  |
	  |  [lib]     [eq]     [search]     [more]  |
	  +==========================================+  <== H - the system bottom inset


	  Full Cover: the labels and the rating/menu row below the cover, no overlay
	  +==========================================+  <== 0, the status bar is the top inset
	  |                                          |
	  |                 cover                    |
	  |                                          |  <== fade start: aaBlendedFadeStart x the art height (62%),
	  |                                          |      at most aaBlendedFadeGap (16dp) above the art bottom
	  +==========================================+  <== art bottom: aaItemHeightPercent x H (60%), lowered to fit the
	  |  Title                                   |      reserves below; also the image view bottom and the overlay top,
	  |  Artist - Album                          |      aaBlendedOverlayReserve is 0dp
	  |  [like] [unlike]                 [menu]  |  <== aaPaddingBottom (@id/blended_full_below_art_reserve): the labels
	  |                                          |      and the rating/menu row inside the item, below the art
	  +==========================================+  <== item bottom
	  |  [vis] [timer]     (controls)    [shuf]  |  <== aaMarginBottom as in Alternative
	  +==========================================+  <== H - the system bottom inset

	  In every layout, when the art is shorter than the safe top + aaBlendedOverlayReserve, the image view extends
	  below the art
	-->
    <attr name="overlap_blended_layout" format="reference"/>
    <attr name="blendedLayoutSelected" format="boolean"/>
    <attr name="overlap_blended_variant" format="reference"/>

    <!-- The set of ids which can be used for layout_*Ref. These are dynamically calculated based on the theme values -->
    <!-- Used for layout_heightRef -->
    <item type="id" name="blended_artwork_view_height"/>
    <!-- Calculated Blended reserves, resolved by from the activity theme. A label line is
         (text size x ?Blended_labelLineHeightFactor + ?Blended_labelLinePadding) x scale, with the text size and the scale
         of ?ItemTrackTitle or ?ItemTrackLine2, its text appearance and its ?ItemTrack*_scene_aa style -->
    <!-- Calculated as: ?Blended_controlsReserve + ?TopPlay layout_maxHeight and layout_marginBottom
         + ?TopWaveseekLayout paddingTop, paddingBottom and layout_marginBottom + navbar_bounds_size
         + max(?Blended_buttonRow, sub_aa_buttons height for its slot line count) -->
    <item type="id" name="blended_controls_reserve"/>
    <!-- Calculated as: title line + line2 line + ?Blended_ListSubstyle_overlayReserve -->
    <item type="id" name="blended_overlay_reserve"/>
    <!-- Calculated as: title line + line2 line + ?Blended_Alt_ListSubstyle_belowArtReserve -->
    <item type="id" name="blended_alt_below_art_reserve"/>
    <!-- Calculated as: line2 line + 2 x max(title line, ?Blended_buttonRow) + ?Blended_Full_ListSubstyle_belowArtReserve -->
    <item type="id" name="blended_full_below_art_reserve"/>

    <!-- Text size factor of a label line, the font bottom - top -->
    <attr name="Blended_labelLineHeightFactor" format="float"/>
    <!-- Paddings and margins of a label line -->
    <attr name="Blended_labelLinePadding" format="dimension"/>
    <!-- A button row: the Alternative row over the art, the Full Cover title and rating rows, and the least
         sub_aa_buttons height -->
    <attr name="Blended_buttonRow" format="dimension"/>
    <!-- The fixed part of blended_overlay_reserve, the Default rating/menu row with its margins -->
    <attr name="Blended_ListSubstyle_overlayReserve" format="dimension"/>
    <!-- The fixed part of blended_alt_below_art_reserve -->
    <attr name="Blended_Alt_ListSubstyle_belowArtReserve" format="dimension"/>
    <!-- The fixed part of blended_full_below_art_reserve -->
    <attr name="Blended_Full_ListSubstyle_belowArtReserve" format="dimension"/>
    <!-- The fixed part of blended_controls_reserve: 16dp gap below the buttons + 32dp around the play button + 4dp (the
         28dp track info line minus the 24dp waveseek layout_marginBottom) -->
    <attr name="Blended_controlsReserve" format="dimension"/>

