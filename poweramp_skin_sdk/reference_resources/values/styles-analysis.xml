<resources xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- The Audio Analysis rows (audio_analysis_*row*.xml, audio_analysis_verdict.xml): the row root, then its label and value cells -->
	<style name="AnalysisRow">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="layout_consumeSpace">vertical</item>
		<item name="android:paddingLeft">?dialogContentPaddingLR</item>
		<item name="android:paddingRight">?dialogContentPaddingLR</item>
		<item name="android:layout_marginBottom">@dimen/dialog_info_separator_padding</item>
		<item name="android:clipChildren">false</item>
	</style>
	<!-- wrap_content keeps the hint's (i), added by the code, after the text. The paddings give the ripple some room, the negative
	     margin keeps the text aligned with the value -->
	<style name="AnalysisRowLabel">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textAppearance">?SubheadText</item>
		<item name="layout_consumeSpace">vertical</item>
		<item name="android:drawablePadding">4dp</item>
		<item name="android:paddingLeft">4dp</item>
		<item name="android:paddingRight">4dp</item>
		<item name="android:layout_marginLeft">-4dp</item>
		<item name="android:background">@drawable/ripple_hidden_rounded_large</item>
	</style>
	<style name="AnalysisRowValue">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textAppearance">?Text</item>
		<item name="layout_consumeSpace">vertical</item>
	</style>
</resources>
